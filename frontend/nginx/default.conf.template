server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Matches the backend's multipart limit (spring.servlet.multipart.max-request-size)
    client_max_body_size 25m;

    # Resolve the backend through Docker's DNS on every request, so nginx starts
    # even if the backend container isn't up yet.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend ${BACKEND_URL};

    location /api/ {
        proxy_pass $backend;
        proxy_http_version 1.1;
        # $http_host keeps the port, so the API sees requests as same-origin (no CORS rejection)
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # The PWA service worker and manifest must never be served stale
    location ~ ^/(sw\.js|registerSW\.js|manifest\.webmanifest)$ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # Hashed build assets can be cached forever
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Client-side routing: unknown paths fall back to the app
    location / {
        try_files $uri $uri/ /index.html;
    }
}
