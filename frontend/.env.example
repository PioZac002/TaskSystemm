# API used by `npm run dev`. Point it at a local backend (./mvnw spring-boot:run in ../backend).
# Leave the variable unset to fall back to http://localhost:6901, or set it empty for same-origin (Docker/nginx).
VITE_API_BASE_URL=http://localhost:6901

# Optional: target for the /api proxy of `vite dev` / `vite preview`
# VITE_PROXY_TARGET=http://localhost:6901

# Enable token debug logging in the browser DevTools console
# Set to 'true' to enable; all logs are prefixed with 🔐 [TOKEN-DEBUG]
VITE_TOKEN_DEBUG=true
