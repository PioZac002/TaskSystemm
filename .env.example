# Copy to .env and adjust. Every value has a working default, so .env is optional for a local run.

# Port on your machine where the app is served: http://localhost:8080
APP_PORT=8080

# PostgreSQL (lives only inside Docker; the data is kept in the "db-data" volume)
POSTGRES_DB=tasksystem
POSTGRES_USER=tasksystem
POSTGRES_PASSWORD=tasksystem

# Secret for signing JWT access tokens. Use at least 32 random bytes outside local testing,
# e.g. the output of: openssl rand -base64 48
JWT_SECRET=local-docker-secret-change-me-0123456789abcdef

# Create demo accounts, teams, projects and issues on the first start (empty database only)
DEMO_SEED=true
